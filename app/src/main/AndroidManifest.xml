<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.fot_times_app">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FOT_Times_App">

        <!-- Splash screen (launcher) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FOT_Times_App">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login screen (after splash) -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.FOT_Times_App" />

        <!-- Signup screen -->
        <activity
            android:name=".SignupActivity"
            android:exported="false"
            android:theme="@style/Theme.FOT_Times_App" />

        <!-- News screen (final home after login) -->
        <activity
            android:name=".NewsActivity"
            android:exported="false"
            android:theme="@style/Theme.FOT_Times_App" />

        <!-- Optional: MainActivity (if still needed for testing or future use) -->
        <!--
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.FOT_Times_App" />
        -->

    </application>
</manifest>
